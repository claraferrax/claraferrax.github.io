IQR <- IQR(data[,i])
Lower <- quartiles[1] - 1.5*IQR
Upper <- quartiles[2] + 1.5*IQR
data<- subset(data, data[,i] > Lower & data[,i] < Upper)
boxplot(data[,i],ylab=i,col="lightblue") #making for every variable a boxplot
}
